# --------------------------------------------------
# Reflex Application
# --------------------------------------------------

APP_NAME=Reflex API
APP_VERSION=1.0.0
ENVIRONMENT=development


# --------------------------------------------------
# Frontend / CORS
# --------------------------------------------------

FRONTEND_URL=http://localhost:3000


# --------------------------------------------------
# Authentication
# --------------------------------------------------

JWT_SECRET=change-this-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480


# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

# Backend Member 2 will configure the real value.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/reflex
