# --------------------------------------------------
# Reflex Application
# --------------------------------------------------

APP_NAME=Reflex API
APP_VERSION=1.0.0
ENVIRONMENT=development


# --------------------------------------------------
# Frontend / CORS
# --------------------------------------------------

FRONTEND_URL=http://localhost:3000


# --------------------------------------------------
# Authentication
# --------------------------------------------------

JWT_SECRET=change-this-secret-before-deployment
ADMIN_SETUP_TOKEN=replace-with-a-long-one-time-setup-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480


# --------------------------------------------------
# Transactional email (Gmail SMTP)
# --------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=LightM Candle
EMAIL_ENABLED=true


# --------------------------------------------------
# Delivery geocoding (OpenStreetMap Nominatim)
# --------------------------------------------------

GEOCODING_ENABLED=true
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Reflex-Delivery-Management/1.0 (contact@example.com)
GEOCODING_EMAIL=
GEOCODING_TIMEOUT_SECONDS=5


# --------------------------------------------------
# PostgreSQL
# --------------------------------------------------

# Supabase: copy the Direct or Session pooler URI from Project > Connect.
# Reflex accepts both postgresql:// and postgresql+psycopg:// and uses psycopg 3.
# URL-encode special characters in the password and require SSL for hosted use.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Local PostgreSQL remains supported for development:
# DATABASE_URL=postgresql+psycopg://reflex_user:CHANGE_ME@localhost:5432/reflex


# --------------------------------------------------
# Legacy dispatcher bootstrap (optional; normal onboarding uses website approval)
# --------------------------------------------------

DISPATCHER_BOOTSTRAP_NAME=Reflex Dispatcher
DISPATCHER_BOOTSTRAP_EMAIL=dispatcher@example.com
DISPATCHER_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
